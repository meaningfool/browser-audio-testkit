{
  "manifest_version": 3,
  "name": "Browser audio test tab recorder",
  "version": "1.0.0",
  "minimum_chrome_version": "153",
  "permissions": ["activeTab", "tabCapture", "offscreen"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Record this isolated test tab" }
}
